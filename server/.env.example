# 服务器配置
PORT=3000
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log

# 安全配置
JWT_SECRET=your-super-secret-jwt-key-change-in-production
PAILLIER_PASSPHRASE=your-super-secret-passphrase-change-in-production

# 混淆配置
ENABLE_OBFUSCATION=true
OBFUSCATION_INTERVAL=30000
FAKE_VOTE_RATIO=0.3

# 数据库配置
DATABASE_PATH=./voting.db