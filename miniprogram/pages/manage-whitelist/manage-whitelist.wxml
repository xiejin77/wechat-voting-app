<!-- pages/manage-whitelist/manage-whitelist.wxml -->
<view class="container">
  <view class="header">
    <text class="title">白名单管理</text>
  </view>
  
  <view class="form">
    <view class="form-item">
      <text class="label">添加用户到白名单</text>
      <input class="input" placeholder="请输入用户ID或手机号" value="{{newUser}}" bindinput="onUserInput" />
      <button class="add-btn" bindtap="addUserToWhitelist">添加用户</button>
    </view>
    
    <view class="form-item">
      <text class="label">白名单用户列表</text>
      <view class="user-list">
        <view class="user-item" wx:for="{{whitelist}}" wx:key="index">
          <text class="user-info">{{item.userId || item.phone}}</text>
          <button class="remove-btn" data-index="{{index}}" bindtap="removeUser">移除</button>
        </view>
      </view>
    </view>
  </view>
</view>